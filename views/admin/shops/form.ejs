<%- include("../../partials/header", { pageTitle }) %>
<%- include("../partials/layout-start", { activeSection }) %>

<section class="admin-page-head">
  <div>
    <p class="eyebrow"><%= mode === "edit" ? "Edit shop" : "Create shop" %></p>
    <h1><%= mode === "edit" ? "Update shop details" : "New shop" %></h1>
    <p class="muted">Keep the public canteen catalog consistent from one screen.</p>
  </div>
</section>

<div class="card admin-panel">
  <form method="post" action="<%= mode === "edit" ? `/admin/shops/${shop._id}/edit` : "/admin/shops" %>" class="form" enctype="multipart/form-data">
    <label>
      <span>Shop name</span>
      <input name="name" type="text" maxlength="120" required value="<%= shop?.name || "" %>" />
    </label>
    <label>
      <span>Slug</span>
      <input name="slug" type="text" maxlength="120" required value="<%= shop?.slug || "" %>" />
    </label>
    <label>
      <span>Description</span>
      <input name="description" type="text" maxlength="220" value="<%= shop?.description || "" %>" />
    </label>
    <label>
      <span>Shop image</span>
      <input name="image" type="file" accept="image/*" />
    </label>
    <% if (shop?.image) { %>
      <img class="food-thumb admin-preview" src="<%= shop.image %>" alt="<%= shop.name %>" />
    <% } %>
    <label>
      <span>Open / closed</span>
      <select name="isOpen">
        <option value="open" <%= !shop || shop.isOpen !== false ? "selected" : "" %>>Open</option>
        <option value="closed" <%= shop?.isOpen === false ? "selected" : "" %>>Closed</option>
      </select>
    </label>
    <label>
      <span>Opening time (IST)</span>
      <input name="openingTime" type="time" value="<%= shop?.openingTime || "" %>" />
    </label>
    <label>
      <span>Closing time (IST)</span>
      <input name="closingTime" type="time" value="<%= shop?.closingTime || "" %>" />
      <p class="muted small" style="margin-top:4px;">Leave both blank to disable scheduled hours. The open/closed toggle above then applies.</p>
    </label>
    <fieldset style="border:1px solid #ddd;border-radius:8px;padding:12px;">
      <legend><strong>Pickup slots</strong></legend>
      <label style="display:flex;align-items:center;gap:8px;">
        <input type="checkbox" name="slotsEnabled" value="true" <%= shop?.pickupSlots?.enabled ? "checked" : "" %> />
        Enable pickup slots
      </label>
      <div class="row" style="gap:12px;flex-wrap:wrap;">
        <label>
          <span>Slot start (IST)</span>
          <input name="slotStartTime" type="time" value="<%= shop?.pickupSlots?.startTime || "" %>" />
        </label>
        <label>
          <span>Slot end (IST)</span>
          <input name="slotEndTime" type="time" value="<%= shop?.pickupSlots?.endTime || "" %>" />
        </label>
        <label>
          <span>Duration (minutes)</span>
          <input name="slotDuration" type="number" min="5" max="240" value="<%= shop?.pickupSlots?.durationMinutes || 15 %>" />
        </label>
        <label>
          <span>Capacity per slot</span>
          <input name="slotCapacity" type="number" min="1" max="500" value="<%= shop?.pickupSlots?.capacity || 10 %>" />
        </label>
        <label>
          <span>Days ahead</span>
          <input name="slotDaysAhead" type="number" min="0" max="7" value="<%= shop?.pickupSlots?.daysAhead ?? 1 %>" />
        </label>
      </div>
    </fieldset>
    <fieldset style="border:1px solid #ddd;border-radius:8px;padding:12px;">
      <legend><strong>Discount</strong></legend>
      <label style="display:flex;align-items:center;gap:8px;">
        <input type="checkbox" name="discountEnabled" value="true" <%= shop?.discount?.enabled ? "checked" : "" %> />
        Enable discount
      </label>
      <label>
        <span>Discount (%)</span>
        <input name="discountPercent" type="number" min="0" max="100" step="0.01" value="<%= shop?.discount?.percent || 0 %>" />
      </label>
    </fieldset>
    <label>
      <span>Assigned vendor</span>
      <select name="vendor">
        <option value="">No vendor assigned</option>
        <% vendors.forEach((vendor) => { %>
          <option value="<%= vendor._id %>" <%= String(shop?.vendor?._id || shop?.vendor || "") === String(vendor._id) ? "selected" : "" %>><%= vendor.name %> (<%= vendor.email %>)</option>
        <% }) %>
      </select>
    </label>
    <div class="row">
      <button class="btn" type="submit"><%= mode === "edit" ? "Save changes" : "Create shop" %></button>
      <a class="btn btn--outline" href="/admin/shops">Cancel</a>
    </div>
  </form>
</div>

<%- include("../partials/layout-end") %>
<%- include("../../partials/footer") %>

