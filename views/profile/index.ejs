<%- include("../partials/header", { pageTitle }) %>

<div class="portal-root student-profile">
<section class="hero hero--compact">
  <h1 class="portal-ink">Your Profile</h1>
</section>

<section class="card profile-head portal-card">
  <div class="profile-avatar"><%= firstName.charAt(0).toUpperCase() %></div>
  <div>
    <h2 class="profile-head__greeting portal-ink"><%= greeting %>, <%= firstName %> &#128075;</h2>
    <p class="muted portal-soft">Ready for your next meal?</p>
  </div>
</section>

<section class="card portal-card">
  <h2 class="card__title portal-ink">Account Information</h2>

  <div class="profile-row">
    <span class="profile-row__label portal-soft">Phone Number</span>
    <span class="profile-row__value portal-ink" id="phone-display"><%= currentUser.phone || "Not added" %></span>
    <button type="button" class="btn btn--ghost btn--small" id="phone-edit-btn">Edit</button>
  </div>
  <div class="profile-row" id="phone-edit-row" hidden>
    <input class="input" id="phone-input" type="tel" inputmode="numeric" maxlength="10"
      placeholder="10-digit mobile number" value="<%= currentUser.phone %>" />
    <button type="button" class="btn btn--small portal-btn" id="phone-save-btn">Save</button>
    <button type="button" class="btn btn--ghost btn--small" id="phone-cancel-btn">Cancel</button>
  </div>
  <p class="muted small" id="phone-msg" hidden></p>

  <div class="profile-row">
    <span class="profile-row__label portal-soft">Email</span>
    <span class="profile-row__value portal-ink"><%= typeof profileEmail !== "undefined" && profileEmail ? profileEmail : "—" %></span>
  </div>

  <div class="profile-row">
    <span class="profile-row__label portal-soft">Member Since</span>
    <% var _ms = (typeof memberSince !== "undefined" && memberSince) ? new Date(memberSince) : null; %>
    <span class="profile-row__value portal-ink"><%= (_ms && !isNaN(_ms.getTime())) ? _ms.toLocaleDateString("en-IN", { day: "numeric", month: "short", year: "numeric" }) : "—" %></span>
  </div>
</section>

<section class="card portal-card student-appearance">
  <h2 class="card__title portal-ink">Appearance</h2>
  <div class="appearance-row">
    <label class="appearance-label portal-soft" for="nav-frost">Bottom Navigation Frost</label>
    <output class="appearance-value portal-ink" id="nav-frost-value" for="nav-frost">50 · Balanced</output>
  </div>
  <input class="appearance-slider" id="nav-frost" type="range" min="0" max="100" step="1" value="50"
    aria-describedby="nav-frost-hint" />
  <p class="muted small" id="nav-frost-hint">0 is clear glass, 100 is heavily frosted. Applies to the bottom navigation on every student screen and is saved on this device.</p>
</section>

<script>
  (function () {
    // Frost preference: local visual setting (localStorage), not an account
    // feature. Runs on DOMContentLoaded so the shared student-glass module
    // (deferred) has already exposed window.FlashFoodsGlass when present.
    var KEY = "flashfoods.navFrost.v1";
    var DEF = 50;
    function clamp(v) {
      v = Math.round(Number(v));
      if (!isFinite(v)) return DEF;
      return Math.min(100, Math.max(0, v));
    }
    function labelFor(v) { return v < 34 ? "Clear" : v < 67 ? "Balanced" : "Strong"; }
    document.addEventListener("DOMContentLoaded", function () {
      var slider = document.getElementById("nav-frost");
      var out = document.getElementById("nav-frost-value");
      if (!slider || !out) return;
      function read() {
        try {
          var raw = localStorage.getItem(KEY);
          return raw === null ? DEF : clamp(raw);
        } catch (e) { return DEF; }
      }
      function render(v) { out.textContent = v + " · " + labelFor(v); }
      function apply(v, save) {
        v = clamp(v);
        render(v);
        if (window.FlashFoodsGlass) {
          window.FlashFoodsGlass.applyNavFrost(v, { persist: !!save });
        } else if (save) {
          try { localStorage.setItem(KEY, String(v)); } catch (e) {}
        }
      }
      var current = read();
      slider.value = String(current);
      apply(current, false);
      slider.addEventListener("input", function () { apply(slider.value, true); });
    });
  })();
</script>

<section class="profile-section">
  <h2 class="profile-section__title portal-ink">Your FlashFoods Activity</h2>
  <div class="profile-stats">
    <div class="card analytics-kpi-card portal-card">
      <p class="analytics-kpi-label">Completed Orders</p>
      <p class="analytics-kpi-value portal-ink"><%= stats.completedCount %></p>
    </div>
    <div class="card analytics-kpi-card portal-card">
      <p class="analytics-kpi-label">Favourite Shop</p>
      <p class="analytics-kpi-value analytics-kpi-value--sm portal-ink"><%= stats.favShop || "No favourite shop yet" %></p>
    </div>
    <div class="card analytics-kpi-card portal-card">
      <p class="analytics-kpi-label">Favourite Item</p>
      <p class="analytics-kpi-value analytics-kpi-value--sm portal-ink"><%= stats.favItem || "No favourite item yet" %></p>
    </div>
    <div class="card analytics-kpi-card portal-card">
      <p class="analytics-kpi-label">Total Money Spent</p>
      <p class="analytics-kpi-value portal-price"><%= "₹" + Math.round(stats.totalSpent).toLocaleString("en-IN") %></p>
    </div>
  </div>
</section>

<section class="card profile-actions portal-card">
  <a class="btn portal-btn" href="/forgot-password">Change Password</a>
  <form method="post" action="/logout" class="inline">
    <button class="btn btn--ghost" type="submit">Logout</button>
  </form>
</section>

<script>
  (function () {
    var display = document.getElementById("phone-display");
    var row = document.getElementById("phone-edit-row");
    var input = document.getElementById("phone-input");
    var msg = document.getElementById("phone-msg");
    var editBtn = document.getElementById("phone-edit-btn");
    var saveBtn = document.getElementById("phone-save-btn");
    var cancelBtn = document.getElementById("phone-cancel-btn");

    function setMsg(text, isError) {
      if (!text) { msg.hidden = true; return; }
      msg.textContent = text;
      msg.style.color = isError ? "var(--danger)" : "var(--green)";
      msg.hidden = false;
    }

    editBtn.addEventListener("click", function () {
      row.hidden = false;
      editBtn.hidden = true;
      setMsg("");
      input.focus();
    });

    cancelBtn.addEventListener("click", function () {
      row.hidden = true;
      editBtn.hidden = false;
      input.value = display.textContent === "Not added" ? "" : display.textContent;
    });

    saveBtn.addEventListener("click", async function () {
      saveBtn.disabled = true;
      setMsg("");
      try {
        var r = await fetch("/profile/phone", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ phone: input.value.trim() }),
        });
        var data = await r.json();
        if (!r.ok || !data.success) {
          setMsg(data.error || "Could not save phone number.", true);
          saveBtn.disabled = false;
          return;
        }
        display.textContent = data.phone;
        row.hidden = true;
        editBtn.hidden = false;
        setMsg("Phone number saved.");
      } catch (err) {
        setMsg("Could not save phone number. Try again.", true);
      }
      saveBtn.disabled = false;
    });
  })();
</script>

<%- include("../partials/student-bottomnav") %>
</div>

<%- include("../partials/footer") %>
