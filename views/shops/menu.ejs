<%- include("../partials/header", { pageTitle }) %>

<div class="portal-root">
<div class="breadcrumb">
  <a href="/shops">Canteens</a>
  <span class="muted"> / </span>
  <span><%= shop.name %></span>
</div>

<section class="hero hero--compact">
  <h1 class="portal-ink"><%= shop.name %></h1>
  <% var availability = locals.availability || { available: shop.isOpen && shop.isActive !== false, label: shop.isOpen && shop.isActive !== false ? "Open" : "Closed", configured: false, hoursLabel: "Hours not set" }; %>
  <p>
    <span class="tag <%= availability.available ? "tag--ok" : "tag--warn" %> portal-pill<%= availability.available ? " portal-pill--ok" : "" %>">
      <%= availability.label %>
    </span>
    <% if (availability.configured) { %>
      <span class="muted small portal-soft"> &middot; <%= availability.hoursLabel %></span>
    <% } %>
  </p>
  <% if (shop.description) { %>
    <p class="muted portal-soft"><%= shop.description %></p>
  <% } %>
</section>

  <!-- Menu search: the same .canteen-search component used on Canteens & Stalls.
       This is the single search input on this page; menu-table.js filters the
       cards from it (data-menu-search). -->
  <div class="canteen-search canteen-search--menu" role="search">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.5" y2="16.5"/></svg>
    <input id="menu-search-input" data-menu-search type="search" placeholder="Search items..." aria-label="Search menu items" autocomplete="off" />
    <button type="button" class="canteen-search__clear" data-search-clear aria-label="Clear search" hidden>
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg>
    </button>
    <button type="button" class="canteen-search__filter" aria-label="Filter options">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="4" y1="7" x2="20" y2="7"/><circle cx="15" cy="7" r="2"/><line x1="4" y1="12" x2="20" y2="12"/><circle cx="9" cy="12" r="2"/><line x1="4" y1="17" x2="20" y2="17"/><circle cx="15" cy="17" r="2"/></svg>
    </button>
  </div>

<% if (!menuItems.length) { %>
  <div class="card portal-card" style="text-align:center;padding:48px 24px;">
    <div style="font-size:48px;margin-bottom:16px;">&#128269;</div>
    <h2 class="portal-ink" style="margin:0 0 8px;">No menu items yet</h2>
    <p class="muted portal-soft">This canteen hasn't added any menu items yet. Check back later!</p>
  </div>
<% } else { %>
  <% shop.orderingOpen = availability.available; %>
<%- include("../partials/menu-table", { mode: "student", items: menuItems, shop: shop }) %>
<% } %>

<%- include("../partials/student-bottomnav") %>
</div>

<%- include("../partials/footer") %>
